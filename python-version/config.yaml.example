# ============ QQ 频道帖子关键字监控 · 配置文件 ============
# 改完保存即可，无需改代码。

# 要监控的频道页面（登录后能看到帖子列表的那个页面）
# 换成你自己想监控的频道链接
channel_url: "https://pd.qq.com/g/iloveswufe?subc=hot"

# 关键字列表：帖子标题或正文里出现其中任意一个，就推送给你（不区分大小写）
# 在下面按需增删，每行一个，前面加 "- "
keywords:
  - 换成你要监控的词

# 每隔多少分钟查一次（太快可能触发风控，建议 3 分钟以上）
interval_minutes: 3

# ============ 通知方式：PushPlus（微信收）============
# 【必填】去 https://www.pushplus.plus/ 微信扫码登录，复制你自己的 token 填到这里
pushplus_token: "在这里填你自己的PushPlus_token"

# ============ 进阶（一般不用改）============
# 抓取接口时浏览器是否隐藏窗口。首次 --setup 需要扫码，请保持 false
headless: false

# 字段名映射：一般留空即可（已按 QQ 频道结构自动解析）
field_map:
  id: ""
  title: ""
  content: ""
  url: ""
